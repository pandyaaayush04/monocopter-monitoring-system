# Copy to .env and fill in real values. Never commit .env.

# Signs the session JWT. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth client (Web application type) - Google Identity Services
GOOGLE_CLIENT_ID=

# Origin(s) allowed to call this API with credentials, comma-separated
CORS_ORIGIN=http://localhost:5173

PORT=8787
